# Copy this file to .env. Gemini is selected automatically when its key is set.
GEMINI_API_KEY=
DEVRAG_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternative provider.
OPENAI_API_KEY=
DEVRAG_OPENAI_MODEL=gpt-4o-mini
# Set to gemini, openai, none, or auto (default).
DEVRAG_PROVIDER=auto
# Optional repository path to index on startup via the UI default.
DEVRAG_REPO=.
